# TeamFlow AI Configuration

# Database
# Default: SQLite for zero-config local development
DATABASE_URL=sqlite:///./teamflow.db
# PostgreSQL / Supabase example:
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Security & JWT
SECRET_KEY=teamflow-ai-super-secret-jwt-key-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Configuration (OpenRouter)
# Optional: If left empty, TeamFlow AI uses its built-in deterministic heuristic engine
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Frontend API URL
VITE_API_URL=http://localhost:8000/api
